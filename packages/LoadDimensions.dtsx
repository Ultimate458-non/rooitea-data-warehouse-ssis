      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{35B9EDA7-65CE-4985-AEFC-BF90989EB1C6}"
          SQLTask:SqlStatementSource="-- 1. Disable constraints to prevent the crash you just experienced&#xA;EXEC sp_MSforeachtable &quot;ALTER TABLE ? NOCHECK CONSTRAINT all&quot;;&#xA;&#xA;-- 2. Clear all Dimension Tables (Except DimBatch, which is loaded later)&#xA;DELETE FROM dbo.DimCustomer;&#xA;DELETE FROM dbo.DimDistributionCentre;&#xA;DELETE FROM dbo.DimExchangeRate;&#xA;DELETE FROM dbo.DimProduct;&#xA;DELETE FROM dbo.DimCurrency;&#xA;DELETE FROM dbo.DimDestinationCountry;&#xA;DELETE FROM dbo.DimMarketSegment;&#xA;DELETE FROM dbo.DimFarm;&#xA;DELETE FROM dbo.DimProductType;&#xA;DELETE FROM dbo.DimRegion;&#xA;DELETE FROM dbo.DimQualityGrade;&#xA;DELETE FROM dbo.DimMarketType;&#xA;DELETE FROM dbo.DimProductCategory;&#xA;DELETE FROM dbo.DimProvince;&#xA;DELETE FROM dbo.DimQualityClass;&#xA;DELETE FROM dbo.DimCountry;&#xA;DELETE FROM dbo.DimDate;&#xA;&#xA;-- 3. Re-enable constraints&#xA;EXEC sp_MSforeachtable &quot;ALTER TABLE ? WITH CHECK CHECK CONSTRAINT all&quot;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
